{
  "name": "shopcart-api",
  "version": "0.1.0",
  "description": "Backend de ShopCart — plataforma web de ventas (Node.js + TypeScript + Express + SQL Server)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx db/migrate.ts migrate",
    "db:clean": "tsx db/migrate.ts clean",
    "db:status": "tsx db/migrate.ts status"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "24.22.1"
  }
}
